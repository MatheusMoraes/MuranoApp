{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "ApiBlockSettings": {
    "Mode": "Disabled",
    "Schedule": {
      "Start": "22:00",
      "End": "06:00",
      "TimeZone": "E. South America Standard Time"
    },
    "IgnoredPaths": [ "/health", "/swagger" ],
    "StatusCode": 503,
    "Message": "API temporariamente indisponível"
  },
  "AllowedHosts": "*"
}
